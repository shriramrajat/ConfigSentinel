# ConfigSentinel Environment Configuration

# Local development
# The local development environment uses the project root directory.
MAPPINGS_DB_PATH=./mappings.db
AUDIT_DB_PATH=./audits.db

# Production configuration (Render)
# Ensure the path corresponds to a persistent disk mount.
# MAPPINGS_DB_PATH=/var/data/mappings.db
# AUDIT_DB_PATH=/var/data/audits.db

# AI Configuration (Semantic Mapping Workflow)
# AI_API_KEY is REQUIRED if you want to use the semantic mapping proposal feature.
# Do NOT commit your actual AI_API_KEY to source control.
AI_API_KEY=

# AI_MODEL is OPTIONAL. It defaults to the model configured in the backend (e.g. gpt-4)
AI_MODEL=gpt-4

# AI_BASE_URL is OPTIONAL. Use this if you are proxying the LLM or using a compatible provider.
AI_BASE_URL=https://api.openai.com/v1
