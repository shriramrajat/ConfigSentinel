# ConfigSentinel Frontend — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# The .env file is gitignored and must never be committed.
#
# -------------------------------------------------------------------------
# VITE_API_BASE_URL
#   URL of the ConfigSentinel backend API.
#   Development default: http://localhost:8000
#   Production: set this to the deployed backend URL in your CI/CD environment.
#   Do NOT hardcode the production URL in source code.
# -------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
